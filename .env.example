# Django API from ../backend (or your deployed API origin)
NEXT_PUBLIC_API_URL=https://event-backend-tex3.onrender.com/api

# Which sections of the site are live. Remove a name to hide its pages and nav entry.
# Available: events, tickets, voting, gallery
NEXT_PUBLIC_FEATURES=events,tickets,voting,gallery

# Contact form (Gmail app password). Without these the form reports that email
# is not configured instead of failing silently.
EMAIL_USER=
EMAIL_PASS=
CONTACT_EMAIL=

# The organiser dashboard / checkout / gate scanner (../frontend), deployed
# separately. /login, /dashboard, /scan and friends redirect here.
NEXT_PUBLIC_PLATFORM_URL=https://events.ozoneentertainmentz.com
